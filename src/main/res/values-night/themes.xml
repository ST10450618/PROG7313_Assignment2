<?xml version="1.0" encoding="utf-8"?>
<!--
    Night variant — mirrors the day theme.
    NoActionBar because we use a Compose TopAppBar instead.
    All actual Material3 theming is handled by BudgetWiseTheme in Theme.kt.
-->
<resources>
    <style name="Theme.BudgetWise" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>