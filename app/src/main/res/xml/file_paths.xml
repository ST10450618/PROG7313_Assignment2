<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider path configuration for CameraX receipt photos.
    external-files-path maps to Context.getExternalFilesDir() — app-private storage.
    No READ_EXTERNAL_STORAGE permission required on API 29+.
    Photos saved to getExternalFilesDir("photos") via createImageFile() in AddExpenseScreen.kt.
-->
<paths>
    <external-files-path name="photos" path="." />
</paths>
